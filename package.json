{
  "name": "dsh-web-m3e",
  "version": "1.5.1",
  "description": "Material 3 Expressive theme for the DeepSeekRuntime Web UI: spec-derived M3 colour roles, expressive shape and motion, M3 menu surfaces, and touch-browser ergonomics. Composes over the built-in light, dark and system themes.",
  "license": "MIT",
  "author": "dsh-web-m3e contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/androidly/dsh-web-m3e.git"
  },
  "homepage": "https://github.com/androidly/dsh-web-m3e#readme",
  "bugs": {
    "url": "https://github.com/androidly/dsh-web-m3e/issues"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "material-design",
    "material-3",
    "m3e",
    "theme",
    "mobile",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
